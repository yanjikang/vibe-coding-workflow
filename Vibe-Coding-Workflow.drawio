          <mxGeometry height="130" width="320" x="1530" y="745" as="geometry" />
        </mxCell>
        <mxCell id="N12B" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#190E11;gradientColor=#0D0708;strokeColor=#EF4444;strokeWidth=2;shadow=1;" value="&lt;div style=&quot;font-family:-apple-system,BlinkMacSystemFont,SF Pro Display,PingFang SC,Helvetica Neue,sans-serif;text-align:left;padding:2px 8px;line-height:1.35;&quot;&gt;&lt;div style=&quot;display:inline-block;background:#1F1F26;border:1px solid #3F3F46;color:#E4E4E7;font-size:10px;font-weight:700;padding:2px 9px;border-radius:10px;margin-bottom:5px;letter-spacing:0.5px;&quot;&gt;&lt;span style=&quot;color:#F87171;margin-right:4px;&quot;&gt;●&lt;/span&gt;STEP 12b · 触发熔断 (&gt;3次)&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#FFFFFF;margin-bottom:3px;&quot;&gt;12b. Git 回滚代码 + 开启新窗口排错&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#A1A1AA;font-weight:400;&quot;&gt;立即回滚污染代码，带报错总结开新窗口切入，并将禁忌写入 Rules&lt;/div&gt;&lt;div style=&quot;margin-top:6px;font-size:11px;color:#A1A1AA;font-weight:500;border-top:1px solid #27272A;padding-top:4px;&quot;&gt;止损：绝不在污染窗口无限死磕&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="320" x="1530" y="905" as="geometry" />
        </mxCell>
